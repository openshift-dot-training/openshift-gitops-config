#!/usr/bin/env bash
# githooks/pre-commit - block real environment data and broken manifests.
#
# Enable once per clone:
#   git config core.hooksPath githooks
#
# 1. scripts/check-sensitive.sh --staged : credentials, non-allowlisted
#    hostnames (internal DNS, git/registry URLs) and IPs in the added lines
# 2. scripts/validate.sh                 : .yaml naming, YAML syntax, hub and
#    component charts render
#
# Bypass for a commit you are sure about: git commit --no-verify
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-sensitive.sh" --staged
"$root/scripts/validate.sh"
